# Banco de dados (SQLite em dev; para Postgres troque o provider em prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Segredo para assinar sessões (mín. 32 caracteres). Gere com: openssl rand -base64 48
AUTH_SECRET=""

# URL pública da aplicação (usada nos links dos e-mails)
APP_URL="http://localhost:3000"

# Admin criado pelo `npm run seed`
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@exemplo.com"
ADMIN_PASSWORD="troque-esta-senha"

# E-mail: "console" apenas imprime no terminal; "mailersend" envia de verdade.
MAIL_DRIVER="console"
# Token de API do MailerSend (Integrations → API tokens)
MAILERSEND_API_KEY=""
# O remetente precisa ser de um domínio verificado no MailerSend
MAIL_FROM="Financeiro <financeiro@exemplo.com>"
# Para onde vão as respostas dos clientes (opcional)
MAIL_REPLY_TO=""

# Lembretes: quantos dias antes do vencimento avisar (separados por vírgula)
REMINDER_DAYS="3"
# Reenviar aviso de fatura vencida a cada N dias ("0" = não enviar avisos de atraso)
OVERDUE_REPEAT_DAYS="0"

# Protege o endpoint /api/cron/notificacoes (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""
# "true" roda as notificações agendadas dentro do próprio servidor Next (a cada hora)
INTERNAL_CRON="true"
# Hora (Brasília) a partir da qual o agendador interno envia os avisos do dia
NOTIFY_FROM_HOUR="8"

# InfinitePay — Checkout Integrado (Vendas → Checkout → Configurações → API Key)
INFINITEPAY_API_KEY=""
# Formas de pagamento aceitas no link: "pix,credit_card" ou só "pix"
INFINITEPAY_METHODS="pix,credit_card"
# Parcelas sem juros para o cliente (0 = desligado; a taxa fica com você)
INFINITEPAY_INSTALLMENTS="0"
# Desconto (%) para pagamento via Pix (0 = sem desconto)
INFINITEPAY_PIX_DISCOUNT="0"

# Onde ficam os arquivos enviados (PDFs de contrato). Fora de /public: só é servido com login.
STORAGE_DIR="./storage"
